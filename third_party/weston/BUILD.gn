config("header_config"){
  #project_version = "6.0.91" #needs a fix
  #package_url = "https://wayland.freedesktop.org"
  #bugreport_url = "https://gitlab.freedesktop.org/wayland/weston/issues/"
  #prefix = rebase_path("//third_party/weston",root_build_dir)
  bindir =  rebase_path("//third_party/weston",root_out_dir)
  datadir = "//chromium/src/third_party/weston/"
  #libexecdir = bindir
  #moduledir = datadir
  #libmodule = "//chromium/src/third_party/weston/libweston"
  xwayland = "usr/bin/Xwayland"
  westonbackend = "drm" + "-backend.so"
  defines = [
    "MAJOR_IN_SYSMACROS",
    "MAJOR_IN_MKDEV",
    "HAVE_MKOSTEMP",    #this is the loop from meson.build
    "HAVE_STRCHRNUL",
    "HAVE_INITGROUPS",
    "POSIX_FALLOCATE",
    "_GNU_SOURCE=1",
    "_ALL_SOURCE=1",
    #"PACKAGE_STRING=weston \"${project_version}\"",
    #"PACKAGE_VERSION=\"${project_version}\"",
    #"VERSION=\"${project_version}\"",
    #"PACKAGE_URL=\"${package_url}\"",
    #"PACKAGE_BUGREPORT=\"${bugreport_url}\"",
    "BINDIR= \"${bindir}\"",
    "DATADIR = \"${datadir}\"",
    "LIBEXECDIR= \"${datadir}\"",
    "MODULEDIR= \"${datadir}\"",
    "LIBWESTON_MODULEDIR= \"${datadir}\"",
    "HAVE_XKBCOMMON_COMPOSE= 1",
    "WESTON_NATIVE_BACKEND = \"${westonbackend}\"",
    #SHARED CONFIGS
    "HAVE_PANGO",
    "HAVE_JPEG",
    "HAVE_WEBP",
    "HAVE_SYSTEMD_LOGIN_209",
    "HAVE_DBUS",
    "HAVE_SYSTEMD_LOGIN",
    "BUILD_RDP_COMPOSITOR",
    "ENABLE_EGL",
    "BUILD_FBDEV_COMPOSITOR",
    "BUILD_DRM_COMPOSITOR",
    "BUILD_HEADLESS_COMPOSITOR",
    "BUILD_X11_COMPOSITOR",
    "BUILD_WAYLAND_COMPOSITOR",
    "ENABLE_JUNIT_XML",
    "HAVE_FREERDP_VERSION_H",
    "HAVE_SURFACE_BITS_BMP",
    "HAVE_GBM_NODIFIERS",
    "HAVE_GBM_FD_IMPORT",
    "BUILD_VAAPI_RECORDER",
    "HAVE_DRM_ADDFB2_MODIFIERS",
    "HAVE_DRM_ATOMIC",
    "HAVE_DRM_FORMATS_BLOB",
    "HAVE_XCB_XKB",
    "USE_RESIZE_POOL",
    "HAVE_LIBDRM_",
    "XSERVER_PATH=\"${xwayland}\"",
    "HAVE_LCMS",
]
}

