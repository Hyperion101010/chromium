config("weston_config") {
  include_dirs = [
    "src",
    "src/include",
    "config",
    "version",
  ]

  out_dir = rebase_path(root_out_dir)
  datadir = out_dir + "/obj/third_party/weston"
  defines = [
    "BINDIR = \"$out_dir\"",
    "DATADIR = \"$datadir\"",
    "LIBEXECDIR = \"$out_dir\"",
    "LIBWESTON_MODULEDIR =  \"$out_dir\"",
    "MODULEDIR = \"$out_dir\"",
  ]
}

pkg_config("pixman") {
  packages = [ "pixman-1" ]
}

pkg_config("cairo") {
  packages = [
    "cairo",
  ]
}


static_library("shared") {

  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [
    "//build/config/compiler:no_chromium_code",
    ":weston_config",
  ]

  sources = [
    "src/shared/config-parser.c",
    "src/shared/file-util.c",
    "src/shared/option-parser.c",
    "src/shared/os-compatibility.c",
    "src/shared/xalloc.c",
  ]

  deps = [
    "//third_party/wayland:wayland_client",
  ]

}

pkg_config("wayland_cursor"){
  packages = [
    "wayland-cursor",
  ]
}

pkg_config("wayland_egl"){
  packages = [
    "wayland-egl",
  ]
}

static_library("cairo_shared") {

  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [
    "//build/config/compiler:no_chromium_code",
    ":weston_config",
    "//build/config/linux/pangocairo",
    ":cairo",
    ":pixman",
    ":libinput_linux",
  ]
  if(use_glib){
    configs += [
      "//build/config/linux:glib",
    ]
  }

  sources = [
    "src/shared/cairo-util.c",
    "src/shared/frame.c",
    "src/shared/image-loader.c",
  ]

  deps = [
    ":shared",
    "//third_party/libpng",
    "//third_party/libjpeg",
  ]
}

